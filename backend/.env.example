# Rotate any API key that has been pasted into a chat or committed to a file.
# Copy this file to .env and place the newly generated key below.
DEEPSEEK_API_KEY=replace_with_a_new_key
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=replace_with_a_new_key
OPENAI_MODEL=set_your_openai_model
JOB_AUTOFILL_PORT=17840
