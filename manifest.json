{
  "manifest_version": 3,
  "name": "Local Job Application Autofill",
  "version": "2.31.0",
  "description": "Fill job applications from a local Docker profile, resume, and adaptive AI answer service.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "identity", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fill this application",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "fill-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Fill the current job application page"
    }
  },
  "options_page": "options.html"
}
